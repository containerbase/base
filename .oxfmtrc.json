{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 80,
  "sortPackageJson": {},
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "/.claude/",
    "/.bash_profile",
    "/.bashrc",
    "/.gitconfig",
    "/.gitmodules",
    "/.idea",
    "/.mcp.json",
    "/.profile",
    "/.ripgreprc",
    "/.zprofile",
    "/.zshrc"
  ]
}
