ARG BASE_IMAGE=latest


#--------------------------------------
# Images
#--------------------------------------
FROM ghcr.io/containerbase/ubuntu:22.04 AS jammy
FROM ghcr.io/containerbase/ubuntu:24.04 AS noble
FROM ghcr.io/containerbase/ubuntu:26.04 AS resolute

FROM ghcr.io/containerbase/ubuntu:24.04 AS latest
#--------------------------------------
# Image: base
#--------------------------------------
FROM ${BASE_IMAGE} AS base

ARG TARGETARCH
COPY dist/docker/ /
COPY dist/cli/containerbase-cli-${TARGETARCH} /usr/local/containerbase/bin/containerbase-cli

ARG APT_HTTP_PROXY
ARG CONTAINERBASE_DEBUG
ARG CONTAINERBASE_CDN
ARG CONTAINERBASE_CDN_GEM
ARG CONTAINERBASE_CDN_NPM
ARG CONTAINERBASE_CDN_PIP
ARG CONTAINERBASE_LOG_LEVEL

RUN install-containerbase

# renovate: datasource=github-releases packageName=containerbase/git-prebuild
RUN install-tool git 2.56.0

RUN set -ex; \
  [ "$(command -v git)" = /usr/local/bin/git ]; \
  for bin in git git-receive-pack git-shell git-upload-archive git-upload-pack scalar; do \
    readlink -f "/usr/local/bin/${bin}" | grep '^/opt/containerbase/tools/git/2\.56\.0/bin/'; \
    [ -x "/usr/local/bin/${bin}" ]; \
    readlink -f "/usr/bin/${bin}" | grep '^/opt/containerbase/tools/git/2\.56\.0/bin/'; \
  done; \
  git --version | grep '^git version 2\.56\.0$'; \
  /usr/bin/git --version | grep '^git version 2\.56\.0$'; \
  perl -v; \
  git --exec-path | grep '^/opt/containerbase/tools/git/2\.56\.0/libexec/git-core$'; \
  su ubuntu -s /bin/sh -c 'env -i PATH=/usr/local/bin:/usr/bin:/bin HOME=/tmp git --version' | grep '^git version 2\.56\.0$'; \
  git config --system --show-origin --get safe.directory | grep '^file:/etc/gitconfig[[:space:]]\*$'; \
  git clone --depth 1 https://github.com/containerbase/git-prebuild.git /tmp/git-prebuild; \
  rm -rf /tmp/git-prebuild; \
  true

#--------------------------------------
# Image: test-git-min
#--------------------------------------
FROM base AS test-git-min

RUN touch /.dummy

# versions before the first prebuild fall back to the newest one
RUN set -ex; \
  install-tool git 2.40.0 > /git-fallback.log 2>&1 || { cat /git-fallback.log; exit 1; }; \
  cat /git-fallback.log; \
  grep -F 'No git 2.40.0 prebuild, installing the newest git ' /git-fallback.log; \
  newest="$(sed -n 's/.*No git 2\.40\.0 prebuild, installing the newest git \([0-9.]*\) instead.*/\1/p' /git-fallback.log)"; \
  [ -n "${newest}" ]; \
  [ ! -e /opt/containerbase/tools/git/2.40.0 ]; \
  git --version | grep -Fx "git version ${newest}"; \
  readlink -f /usr/local/bin/git | grep -Fx "/opt/containerbase/tools/git/${newest}/bin/git"; \
  rm /git-fallback.log; \
  true

# the oldest supported git, keep it in sync with `minVersion` in
# `src/cli/tools/git/index.ts`, no renovate updates
RUN install-tool git 2.48.0

RUN set -ex; \
  [ "$(command -v git)" = /usr/local/bin/git ]; \
  for bin in git git-receive-pack git-shell git-upload-archive git-upload-pack scalar; do \
    readlink -f "/usr/local/bin/${bin}" | grep '^/opt/containerbase/tools/git/2\.48\.0/bin/'; \
    [ -x "/usr/local/bin/${bin}" ]; \
  done; \
  git --version | grep '^git version 2\.48\.0$'; \
  /usr/bin/git --version | grep '^git version 2\.48\.0$'; \
  git --exec-path | grep '^/opt/containerbase/tools/git/2\.48\.0/libexec/git-core$'; \
  git config --system --show-origin --get safe.directory | grep '^file:/etc/gitconfig[[:space:]]\*$'; \
  git init -q /tmp/git-min; \
  git -C /tmp/git-min status; \
  git ls-remote https://github.com/containerbase/git-prebuild.git HEAD; \
  rm -rf /tmp/git-min; \
  true

#--------------------------------------
# Image: test-git-apt
#--------------------------------------
FROM base AS test-git-apt

RUN touch /.dummy

# apt packages depending on git use the prebuild instead of ubuntu's git
RUN set -ex; \
  version="$(git --version | sed -n 's/^git version //p')"; \
  [ -n "${version}" ]; \
  dpkg -s containerbase-git | grep -Fx "Version: ${version}"; \
  install-apt git-lfs tig; \
  if dpkg -s git; then exit 1; fi; \
  [ "$(command -v git)" = /usr/local/bin/git ]; \
  readlink -f /usr/bin/git | grep -Fx "/opt/containerbase/tools/git/${version}/bin/git"; \
  git --version | grep -Fx "git version ${version}"; \
  git lfs version; \
  tig --version; \
  true

#--------------------------------------
# Image: build
#--------------------------------------
FROM base AS build

RUN arch | tee | grep x86_64

RUN touch /.dummy

RUN prepare-tool all

#--------------------------------------
# Image: test
#--------------------------------------
FROM build AS test

# renovate: datasource=github-releases packageName=bazelbuild/bazelisk
RUN install-tool bazelisk v1.30.0

# renovate: datasource=github-releases packageName=bufbuild/buf
RUN install-tool buf v1.74.0

# renovate: datasource=npm
RUN install-tool bun 1.4.3

# renovate: datasource=docker
RUN install-tool dart 3.13.6

# renovate: datasource=github-releases packageName=denoland/deno
RUN install-tool deno 2.9.7

# renovate: datasource=github-releases packageName=jetify-com/devbox
RUN install-tool devbox 0.18.4

# renovate: datasource=dotnet packageName=dotnet-sdk
RUN install-tool dotnet 10.0.402

# renovate: datasource=github-releases packageName=containerbase/flutter-prebuild
RUN install-tool flutter 3.47.7

# renovate: datasource=github-releases packageName=fluxcd/flux2
RUN install-tool flux v2.9.6

# renovate: datasource=github-releases packageName=git-lfs/git-lfs
RUN install-tool git-lfs v3.8.0

RUN set -ex; \
  git lfs version | grep '^git-lfs/3\.8\.0 '; \
  git config --system --get filter.lfs.process | grep -F 'git-lfs filter-process'; \
  true

# renovate: datasource=github-releases packageName=gleam-lang/gleam
RUN install-tool gleam 1.19.2

# renovate: datasource=github-releases packageName=containerbase/golang-prebuild
RUN install-tool golang 1.27.3

# renovate: datasource=github-releases packageName=helm/helm
RUN install-tool helm v4.3.1

# renovate: datasource=github-releases packageName=helmfile/helmfile
RUN install-tool helmfile v1.8.2

# renovate: datasource=github-releases packageName=kubernetes/kubernetes
RUN install-tool kubectl v1.37.1

# renovate: datasource=github-releases packageName=kubernetes-sigs/kustomize
RUN install-tool kustomize 5.8.3

# renovate: datasource=github-releases packageName=jdx/mise
RUN install-tool mise 2026.10.17

# renovate: datasource=datasource=github-releases packageName=containerbase/nix-prebuild
RUN install-tool nix 2.24.10

# renovate: datasource=github-releases packageName=prefix-dev/pixi
RUN install-tool pixi v0.82.1

# renovate: datasource=github-releases packageName=PowerShell/PowerShell
RUN install-tool powershell v7.6.7

# renovate: datasource=docker versioning=docker
RUN install-tool rust 1.99.1

# renovate: datasource=github-releases packageName=containerbase/skopeo-prebuild
RUN install-tool skopeo 1.24.1

# renovate: datasource=github-releases packageName=getsops/sops
RUN install-tool sops v3.13.3

# not yet supported on resolute https://github.com/swiftlang/swift-docker/issues/524
# renovate: datasource=docker depName=swift
ARG SWIFT_VERSION=6.4.1
RUN set -ex; \
  if [ "$(. /etc/os-release && echo "${VERSION_CODENAME}")" = "resolute" ]; then \
    echo "Skipping Swift installation on resolute."; \
  else \
    install-tool swift; \
  fi; \
  true

# renovate: datasource=docker packageName=hashicorp/terraform versioning=docker
RUN install-tool terraform 1.16.6

# renovate: datasource=github-releases packageName=opentofu/opentofu
RUN install-tool tofu 1.13.1

# renovate: datasource=github-releases packageName=jsonnet-bundler/jsonnet-bundler
RUN install-tool jb v0.6.0

# renovate: datasource=github-releases packageName=vmware-tanzu/carvel-vendir
RUN install-tool vendir v0.46.3

# renovate: datasource=github-releases packageName=containerbase/wally-prebuild
RUN install-tool wally 0.3.2

# renovate: datasource=github-releases packageName=protocolbuffers/protobuf versioning=docker
RUN install-tool protoc 36.2

#--------------------------------------
# Image: test-docker
#--------------------------------------
FROM build AS test-docker

# renovate: datasource=github-releases packageName=moby/moby
RUN install-tool docker v28.5.2

# renovate: datasource=github-releases packageName=docker/buildx
RUN install-tool buildx v0.38.1

# renovate: datasource=github-releases packageName=docker/compose
RUN install-tool docker-compose v5.6.1

#--------------------------------------
# Image: test-erlang
#--------------------------------------
FROM build AS test-erlang

# renovate: datasource=github-releases packageName=containerbase/erlang-prebuild versioning=docker
RUN install-tool erlang 28.5.0.8
# renovate: datasource=github-releases packageName=elixir-lang/elixir
RUN install-tool elixir 1.20.4

#--------------------------------------
# Image: test-haskell
#--------------------------------------
FROM build AS test-haskell

# renovate: datasource=github-releases packageName=haskell/cabal versioning=docker
RUN install-tool cabal 3.18.2.0
# renovate: datasource=docker packageName=haskell
RUN install-tool ghc 9.14.1

#--------------------------------------
# Image: test-java
#--------------------------------------
FROM build AS test-java

# renovate: datasource=java-version packageName=java-jre?os=linux&architecture=x64
RUN install-tool java 25.0.4+101.0.LTS
# renovate: datasource=gradle-version packageName=gradle versioning=gradle
RUN install-tool gradle 9.8.2
# renovate: datasource=github-releases packageName=containerbase/maven-prebuild versioning=maven
RUN install-tool maven 3.10.0

#--------------------------------------
# test: test-mono
#--------------------------------------
FROM build AS test-mono

# renovate: datasource=github-releases packageName=containerbase/mono-prebuild
RUN install-tool mono 6.14.1

# partial version
RUN install-tool nuget 6

RUN set -ex; \
  nuget help | grep 'NuGet Version: 6\.';

# renovate: datasource=nuget packageName=NuGet.CommandLine
RUN install-tool nuget 7.9.0

#--------------------------------------
# Image: test-node
#--------------------------------------
FROM build AS test-node

# renovate: datasource=github-releases packageName=containerbase/node-prebuild versioning=node
RUN install-tool node 24.22.0
# renovate: datasource=npm
RUN install-tool pnpm 12.14.0
# renovate: datasource=npm packageName=@yarnpkg/cli-dist
RUN install-tool yarn 4.18.1

# renovate: datasource=github-releases packageName=voidzero-dev/vite-plus
RUN install-tool vp 1.3.0

#--------------------------------------
# Image: test-php
#--------------------------------------
FROM build AS test-php

# renovate: datasource=github-releases packageName=containerbase/php-prebuild
RUN install-tool php 8.5.11
# renovate: datasource=github-releases packageName=containerbase/composer-prebuild
RUN install-tool composer 2.10.3

#--------------------------------------
# Image: test-python
#--------------------------------------
FROM build AS test-python

# renovate: datasource=github-releases packageName=containerbase/python-prebuild
RUN install-tool python 3.14.8

# renovate: datasource=pypi
RUN install-tool checkov 3.3.27
# renovate: datasource=pypi
RUN install-tool conan 2.33.0
# renovate: datasource=pypi
RUN install-tool copier 9.19.0
# renovate: datasource=pypi
RUN install-tool hashin 1.0.5
# renovate: datasource=pypi
RUN install-tool kas 5.5
# renovate: datasource=pypi
RUN install-tool pipenv 2026.10.2
# renovate: datasource=pypi
RUN install-tool pdm 2.29.3
# renovate: datasource=pypi
RUN install-tool poetry 2.5.1
# renovate: datasource=pypi
RUN install-tool uv 0.13.4

#--------------------------------------
# Image: test-ruby
#--------------------------------------
FROM build AS test-ruby

# renovate: datasource=github-releases packageName=containerbase/ruby-prebuild versioning=ruby
RUN install-tool ruby 4.0.7
# renovate: datasource=rubygems versioning=ruby
RUN install-tool bundler 4.0.23
# renovate: datasource=rubygems versioning=ruby
RUN install-tool cocoapods 1.17.0

#--------------------------------------
# Image: final
#--------------------------------------
FROM base

COPY --from=test /.dummy /.dummy
COPY --from=test-docker /.dummy /.dummy
COPY --from=test-erlang /.dummy /.dummy
COPY --from=test-git-apt /.dummy /.dummy
COPY --from=test-git-min /.dummy /.dummy
COPY --from=test-haskell /.dummy /.dummy
COPY --from=test-java /.dummy /.dummy
COPY --from=test-mono /.dummy /.dummy
COPY --from=test-node /.dummy /.dummy
COPY --from=test-php /.dummy /.dummy
COPY --from=test-python /.dummy /.dummy
COPY --from=test-ruby /.dummy /.dummy
