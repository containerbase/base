{
  "name": "containerbase",
  "version": "0.0.0-semantic-release",
  "private": true,
  "license": "MIT",
  "author": "Rhys Arkins <rhys@arkins.net>",
  "contributors": [
    "Michael Kriese <michael.kriese@visualon.de>"
  ],
  "repository": "https://github.com/containerbase/base.git",
  "type": "module",
  "scripts": {
    "bats": "node tools/bats.js --timing --verbose-run",
    "build": "run-s 'build:*'",
    "build:base": "tsc -p packages/base",
    "build:cli": "node tools/build.js",
    "lint": "run-s oxfmt oxlint lint:types lint:docs lint:markdown lint:schema lint:tools lint:versions",
    "lint:docs": "node tools/lint-docs.ts",
    "lint:markdown": "markdownlint-cli2 '**/*.md'",
    "lint:schema": "pnpm schema && git diff --exit-code docs/list-tools.schema.json",
    "lint:tools": "pnpm tools && git diff --exit-code packages/base",
    "lint:types": "run-p 'lint:types:*'",
    "lint:types:default": "tsc",
    "lint:types:dist": "tsc -p tsconfig.dist.json",
    "lint:versions": "node tools/lint-versions.ts",
    "lint-fix": "run-s oxfmt-fix oxlint-fix 'lint-fix:*'",
    "lint-fix:markdown": "markdownlint-cli2 --fix '**/*.md'",
    "oxfmt": "oxfmt --check",
    "oxfmt-fix": "oxfmt",
    "oxlint": "oxlint",
    "oxlint-fix": "oxlint --fix",
    "prepare": "husky",
    "schema": "node tools/schema.ts",
    "start": "tsx src/cli/index.ts",
    "test": "run-s 'test:*'",
    "test:bats": "node tools/bats.js --timing --verbose-run test/bash/ test/bash/v2",
    "test:docker": "node tools/test.js",
    "test:vitest": "vitest run --coverage",
    "tool-versions": "node tools/download-tool-versions.ts",
    "tools": "tsx tools/tools.ts"
  },
  "dependencies": {
    "@nodable/compact-builder": "2.0.0",
    "@nodable/flexible-xml-parser": "1.11.3",
    "@renovatebot/pep440": "5.0.1",
    "@seald-io/nedb": "4.1.2",
    "@sindresorhus/is": "8.1.0",
    "clipanion": "3.2.1",
    "common-tags": "1.8.2",
    "deepmerge": "4.3.1",
    "del": "8.0.1",
    "execa": "9.6.1",
    "global-agent": "3.0.0",
    "got": "15.1.0",
    "ini": "7.0.0",
    "inversify": "8.2.3",
    "node-ipc": "12.0.0",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "pretty-ms": "9.3.1",
    "reflect-metadata": "0.2.2",
    "semver": "7.8.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@containerbase/istanbul-reports-html": "2.0.23",
    "@containerbase/oxlint-plugin": "1.0.3",
    "@containerbase/semantic-release-pnpm": "1.4.3",
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@types/common-tags": "1.8.4",
    "@types/global-agent": "3.0.0",
    "@types/ini": "4.1.1",
    "@types/node": "24.19.2",
    "@types/node-ipc": "9.2.3",
    "@types/semver": "7.8.0",
    "@types/shelljs": "0.10.0",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/ui": "4.1.12",
    "@yao-pkg/pkg": "6.24.0",
    "bats": "1.13.0",
    "bats-assert": "2.2.4",
    "bats-support": "0.3.0",
    "clipanion": "3.2.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.24.0",
    "nock": "14.0.17",
    "npm-run-all2": "9.0.4",
    "oxfmt": "0.75.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "rolldown": "1.2.15",
    "semantic-release": "25.0.9",
    "shelljs": "0.10.0",
    "tsx": "4.23.15",
    "type-fest": "5.10.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "peerDependencies": {
    "markdownlint": "*",
    "thread-stream": "*"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": "^12.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}
