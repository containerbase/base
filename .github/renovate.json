{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>containerbase/.github",
    "github>containerbase/.github//merge-queue.json"
  ],
  "ignorePaths": ["**/node_modules/**", "**/__fixtures__/**", "test/*/test/**"],
  "enabledManagers": [
    "dockerfile",
    "github-actions",
    "mise",
    "nodenv",
    "npm",
    "custom.regex"
  ],
  "separateMultipleMajor": false,
  "separateMajorMinor": true,
  "baseBranchPatterns": ["$default", "zzz/don-not-delete"],
  "packageRules": [
    {
      "description": "Don't hold back any PRs for approval",
      "dependencyDashboardApproval": false,
      "matchPackageNames": ["*"]
    },
    {
      "description": "Hold back npm major updates in root package.json",
      "matchUpdateTypes": ["major"],
      "matchFileNames": ["package.json"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Disable all managers in test/ by default",
      "matchFileNames": ["test/**"],
      "enabled": false
    },
    {
      "description": "Enable the regex manager only for test/",
      "matchFileNames": ["test/**"],
      "matchManagers": ["custom.regex"],
      "enabled": true
    },
    {
      "description": "Disable pin digest for test/",
      "matchFileNames": ["test/**"],
      "matchUpdateTypes": ["pinDigest"],
      "enabled": false
    },
    {
      "description": "Separate patch updates in test/ so that we can automerge them",
      "matchFileNames": ["test/**"],
      "separateMinorPatch": true
    },
    {
      "description": "Don't automerge test minor/major because we might want to retain old versions in tests too",
      "matchFileNames": ["test/**"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false
    },
    {
      "description": "Don't separate minor and patch updates in tests",
      "matchFileNames": ["test/**"],
      "matchDepNames": [
        "apko",
        "apm",
        "aube",
        "bazelisk",
        "buf",
        "buildx",
        "bun",
        "bundler",
        "conan",
        "copier",
        "corepack",
        "dart",
        "deno",
        "devbox",
        "docker",
        "docker-compose",
        "dotnet",
        "flutter",
        "flux",
        "gh",
        "git",
        "git-lfs",
        "gleam",
        "gradle",
        "kubectl",
        "kustomize",
        "hashin",
        "helm",
        "helmfile",
        "jq",
        "julia",
        "kas",
        "mise",
        "nix",
        "node",
        "npm",
        "nub",
        "pdm",
        "pipenv",
        "pixi",
        "poetry",
        "pnpm",
        "protoc",
        "rake",
        "renovate",
        "rust",
        "sbt",
        "sops",
        "swift",
        "terraform",
        "tofu",
        "uv",
        "vendir",
        "vp",
        "wally",
        "yarn"
      ],
      "separateMinorPatch": false
    },
    {
      "description": "Automerge test selected minor updates in tests",
      "matchFileNames": ["test/**"],
      "matchDepNames": [
        "apko",
        "apm",
        "aube",
        "bazelisk",
        "buf",
        "buildx",
        "bun",
        "bundler",
        "conan",
        "copier",
        "corepack",
        "dart",
        "deno",
        "devbox",
        "docker",
        "docker-compose",
        "dotnet",
        "flutter",
        "flux",
        "gh",
        "git",
        "git-lfs",
        "gleam",
        "gradle",
        "kubectl",
        "kustomize",
        "hashin",
        "helm",
        "helmfile",
        "jq",
        "julia",
        "kas",
        "mise",
        "nix",
        "node",
        "npm",
        "nub",
        "pdm",
        "pipenv",
        "pixi",
        "poetry",
        "pnpm",
        "protoc",
        "rake",
        "renovate",
        "rust",
        "sbt",
        "sops",
        "swift",
        "terraform",
        "tofu",
        "uv",
        "vendir",
        "vp",
        "wally",
        "yarn"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Trigger fix release for git and jq updates",
      "matchDepNames": ["git", "jq"],
      "semanticCommitType": "fix",
      "minimumReleaseAge": "5 days"
    },
    {
      "description": "Update the embedded tool-versions data daily with a fix release, so each day has a release with fresh offline data",
      "matchDepNames": ["tool-versions"],
      "extends": ["schedule:daily"],
      "semanticCommitType": "fix",
      "prPriority": 10
    },
    {
      "description": "Handle the tag prefix of jq releases",
      "matchPackageNames": ["jqlang/jq"],
      "extractVersion": "^jq-(?<version>.*)$"
    },
    {
      "description": "Wait for cabal binaries, which are uploaded after the GitHub release",
      "matchPackageNames": ["haskell/cabal"],
      "minimumReleaseAge": "2 days"
    },
    {
      "description": "Corepack can't run pnpm 11+, keep the corepack test on pnpm 10",
      "matchDepNames": ["pnpm-corepack"],
      "allowedVersions": "<11"
    },
    {
      "description": "Trigger fix release for ubuntu digest updates",
      "matchDepNames": ["ubuntu", "ghcr.io/containerbase/ubuntu"],
      "matchUpdateTypes": ["digest"],
      "semanticCommitType": "fix"
    },
    {
      "description": "Use `build` semantic commit scope for build deps",
      "matchDepNames": ["@yao-pkg/pkg"],
      "semanticCommitType": "build"
    },
    {
      "description": "Use `build` semantic commit scope for lockfile maintenance.",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "semanticCommitType": "build"
    },
    {
      "description": "Use `chore` semantic commit scope for Actions updates",
      "matchManagers": ["github-actions"],
      "semanticCommitType": "chore"
    },
    {
      "description": "Use `test` semantic commit scope and additionalBranchPrefix for test/",
      "matchFileNames": ["test/**"],
      "matchDepNames": ["!git"],
      "additionalBranchPrefix": "test-",
      "semanticCommitType": "test"
    },
    {
      "description": "Use `test-major-` additionalBranchPrefix for test/ major updates",
      "matchFileNames": ["test/**"],
      "matchUpdateTypes": ["major"],
      "matchDepNames": ["!git"],
      "additionalBranchPrefix": "test-major-"
    },
    {
      "description": "Update some deps only weekly",
      "matchDepNames": ["checkov", "renovate"],
      "extends": ["schedule:weekly"],
      "automerge": true
    },
    {
      "description": "Use branch merge for maintenace branches",
      "matchBaseBranches": ["/^maint/.+/"],
      "automergeType": "branch",
      "prCreation": "not-pending",
      "rebaseWhen": "auto"
    },
    {
      "description": "Disable test deps on maintenance branches",
      "matchBaseBranches": ["/^maint/.+/"],
      "matchFileNames": ["test/**"],
      "matchDepNames": ["!git"],
      "enabled": false
    },
    {
      "description": "Group java test deps",
      "matchDepNames": ["java", "java-jdk", "java-jre"],
      "matchFileNames": ["test/**"],
      "groupName": "java"
    },
    {
      "description": "Keep the old java LTS test stages on their major, only the newest LTS gets major updates",
      "matchDepNames": ["java", "java-jdk", "java-jre"],
      "matchFileNames": ["test/java/Dockerfile"],
      "matchCurrentVersion": "/^(17|21)\\./",
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Keep the gradle 8 test stage on its major, it tests gradle 8 on java 21",
      "matchDepNames": ["gradle"],
      "matchFileNames": ["test/java/Dockerfile"],
      "matchCurrentVersion": "/^8\\./",
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Keep the old dotnet LTS test stage on its major, only the newest LTS gets major updates",
      "matchDepNames": ["dotnet"],
      "matchFileNames": ["test/dotnet/Dockerfile"],
      "matchCurrentVersion": "/^8\\./",
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Keep the previous erlang major test stage on its major, only the newest major gets major updates",
      "matchDepNames": ["erlang"],
      "matchFileNames": ["test/erlang/Dockerfile"],
      "matchCurrentVersion": "/^28\\./",
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Keep the old node LTS test stages on their major, only the newest LTS gets major updates",
      "matchDepNames": ["node"],
      "matchFileNames": ["test/node/Dockerfile"],
      "matchCurrentVersion": "/^(22|24)\\./",
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["package.json"],
      "matchStrings": [
        "\"(?<depName>@yao-pkg/pkg|clipanion)@(?<currentValue>\\d+\\.\\d+\\.\\d+)\":"
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Update the embedded tool-versions release",
      "managerFilePatterns": ["tools/tool-versions.ts"],
      "matchStrings": [
        "toolVersionsVersion = '(?<currentValue>\\d+\\.\\d+\\.\\d+)'"
      ],
      "depNameTemplate": "tool-versions",
      "packageNameTemplate": "containerbase/tool-versions",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ]
}
