{
  "name": "@containerbase/base",
  "version": "0.0.0-semantic-release",
  "description": "Metadata about the tools supported by containerbase",
  "keywords": [
    "containerbase",
    "tools"
  ],
  "homepage": "https://github.com/containerbase/base#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/containerbase/base.git",
    "directory": "packages/base"
  },
  "files": [
    "data",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "default": "./dist/zod.js"
    },
    "./package.json": "./package.json",
    "./tools.json": "./data/tools.json",
    "./tools.schema.json": "./data/tools.schema.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/semver": "7.8.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.10.0"
  }
}
